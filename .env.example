# Variables de entorno de ejemplo (copiar a .env y ajustar).
# .env NO se sube al repositorio.

# Base de datos (PostgreSQL en Docker local)
POSTGRES_USER=ica
POSTGRES_PASSWORD=ica
POSTGRES_DB=ica
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Almacenamiento de evidencias (MinIO local, emula Cloud Storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=ica-evidencias

# Puertos de la aplicación
BACKEND_PORT=3000
FRONTEND_PORT=4200
