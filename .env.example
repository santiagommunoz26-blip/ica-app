# Variables de entorno de ejemplo (copiar a .env y ajustar).
# .env NO se sube al repositorio.

# Base de datos (PostgreSQL en Docker local)
POSTGRES_USER=ica
POSTGRES_PASSWORD=ica
POSTGRES_DB=ica
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Almacenamiento de evidencias (MinIO local, emula Cloud Storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=ica-evidencias

# Puertos de la aplicación
BACKEND_PORT=3000
FRONTEND_PORT=4200

# Autenticación (M1) ------------------------------------------------------
# Clave para firmar los JWT. En desarrollo, si falta, se genera una temporal
# (las sesiones se pierden al reiniciar); en producción es OBLIGATORIA.
JWT_SECRETO=
# Duración del token de acceso (segundos) y del refresco (días).
JWT_EXPIRACION_ACCESO_SEGUNDOS=900
JWT_REFRESH_DIAS=7
JWT_REFRESH_DIAS_RECORDAR=30
# Minutos de inactividad tras los cuales se cierra la sesión (RF02).
# Confirmado con el usuario el 15 oct 2026: 15 minutos.
SESION_INACTIVIDAD_MINUTOS=15
# Minutos de vigencia del enlace de recuperación de contraseña (RF06).
PASSWORD_RECUPERACION_MINUTOS=30
# Correo de recuperación. Hoy solo existe el transporte «consola», que escribe
# el enlace en el registro del servidor; el transporte SMTP está pendiente de
# que el usuario aporte las credenciales (no se guardan en el repositorio).
CORREO_TRANSPORTE=consola
# URL del frontend para armar el enlace de recuperación.
URL_BASE_FRONTEND=http://localhost:4200
# Orígenes permitidos por CORS (separados por coma).
CORS_ORIGENES=http://localhost:4200

# Primer administrador (script seed:admin) ---------------------------------
# Si no se pasan por argumento (--correo, --nombre, --password), se toman de aquí.
SEED_ADMIN_CORREO=
SEED_ADMIN_NOMBRE=
SEED_ADMIN_PASSWORD=
